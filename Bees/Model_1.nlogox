<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[globals [num-left days num-in-hive random-bee left-farm hive-x hive-y num-returned]

turtles-own [athive directionx directiony wait-bool]
patches-own [pollination crop]

to setup
  clear-all
  set hive-x 0
  set hive-y 0
  set left-farm 0
  set num-returned 0
  ask patches [if random-float 1 <= .85 [set pcolor 56 set crop 1]]
  create-turtles 65000 [set size 0 set shape "bee" set athive 1 set color yellow - 1 set wait-bool False set xcor hive-x set ycor hive-y]
  set num-in-hive 65000
  reset-ticks
end

to emergency-reset
  clear-all
  clear-turtles
end


to new-day
  
  stop
  
  set left-farm 0
  
  set-current-plot "Bee Statistics"
  set-current-plot-pen "Dayline"
  plot plot-y-max 
  
  set-current-plot "Pollination"
  set-current-plot-pen "Dayline"
  plot plot-y-max 
  
  
  clear-turtles
  create-turtles 65000 [set size 0 set shape "bee" set athive 1 set color yellow - 1 set wait-bool False set xcor hive-x set ycor hive-y]
  set days (days + 1)
  set num-left 0
  set num-in-hive 65000
  set num-returned 0
  
end

to go
  
  set-current-plot "Bee Statistics"
  
  set-current-plot-pen "Dayline"
  
  plot 0
  
  set-current-plot-pen "Left Farm"
  
  plot left-farm
  
  set-current-plot-pen "Number in Hive"
  
  plot num-in-hive
  
  set-current-plot-pen "Number Returned"
  
  plot num-returned
  
  set-current-plot "Pollination"
  
  set-current-plot-pen "Dayline"
  
  plot 0
  
  set-current-plot-pen "No Pollination" 
  
  plot (count patches with [pollination = 0 and crop = 1] / count patches with [crop = 1] * 100)
  
  set-current-plot-pen "Pollination 1-4" 
  
  plot (count patches with [pollination < 5 and pollination > 0 and crop = 1] / count patches with [crop = 1] * 100)
  
  set-current-plot-pen "Pollination 5-8" 
  
  plot (count patches with [pollination < 9 and pollination > 4 and crop = 1] / count patches with [crop = 1] * 100)
  
  set-current-plot-pen "Pollination 9-12" 
  
  plot (count patches with [pollination < 13 and pollination > 8 and crop = 1] / count patches with [crop = 1] * 100)
  
  set-current-plot-pen "Pollination 13-16" 
  
  plot (count patches with [pollination < 17 and pollination > 12 and crop = 1] / count patches with [crop = 1] * 100)
  
  set-current-plot-pen "Pollination 17-20" 
  
  plot (count patches with [pollination > 16 and crop = 1] / count patches with [crop = 1] * 100)
 
  
  ask patches with [pollination != 0] [set pcolor 46 + pollination / 6]

  ask turtles [if xcor = hive-x and ycor = hive-y and athive = 0 [set athive 1]]
  
  ask turtles [if (abs(xcor - hive-x) < .5 and abs(ycor - hive-y) < .5 and athive = 3) [set athive 4 set num-returned num-returned + 1]]
  
  ask turtles with [athive = 4] [set num-in-hive num-in-hive + 1 die]
  
  ask turtles [if random 300 < 7 and random 100 = 1 and athive = 1 [set athive 2 facexy random-xcor random-ycor fd .5 set num-left (num-left + 1) set num-in-hive num-in-hive - 1]]
  
  ask turtles with [athive = 2 and not wait-bool] [fd .5]
  ask turtles with [wait-bool] [if random 4 = 1 [set wait-bool False]]
  ask turtles with [athive = 2 and not wait-bool] [set directionx directionx + random 20 - 9.5 set directiony directiony + random 20 - 9.5]
  ask turtles with [athive = 2 and not wait-bool] [facexy directionx directiony]
  ask turtles with [athive = 2 and not wait-bool] [if pollination < 20 and crop = 1 and random 200 < (20 - pollination) [set pollination pollination + 1 set wait-bool True]]
  ask turtles with [athive = 2 and not wait-bool] [if pollination > 0 and crop = 1 and random 500 = 1 [set athive 3]]
  
  ask turtles with [athive = 3] [facexy hive-x hive-y fd .5 + random-float .5]
  ask turtles with [xcor > max-pxcor - 1 or xcor < min-pxcor + 1 or ycor > max-pycor - 1 or ycor < min-pycor + 1] [set athive 5 set left-farm left-farm + 1 set num-in-hive num-in-hive + 1 die]
  
  if num-left > 55000 and random 1000000 < 5 * (num-left - 55000) [new-day]
  
end]]></code>
